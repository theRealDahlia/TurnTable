# Copy to .env and fill in. .env is gitignored.
# Client ID of your Spotify app (https://developer.spotify.com/dashboard). It is public; PKCE needs no client secret.
MAIN_VITE_SPOTIFY_CLIENT_ID=
# Client ID of a Google Cloud OAuth client of type "Desktop app", with the YouTube Data API v3 enabled (see README).
MAIN_VITE_YOUTUBE_CLIENT_ID=
# Google issues a secret with Desktop clients and its token endpoint may require it. It is not confidential for installed apps; leave empty if sign-in works without it.
MAIN_VITE_YOUTUBE_CLIENT_SECRET=
# Client ID of your TIDAL app (https://developer.tidal.com; see README). It is public; PKCE needs no client secret.
MAIN_VITE_TIDAL_CLIENT_ID=
